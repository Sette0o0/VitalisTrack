{
	"expo": {
		"name": "VitalisTrack",
		"slug": "vitalis-track",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "vitalistrack",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"permissions": [
				"ACCESS_COARSE_LOCATION",
				"ACCESS_FINE_LOCATION",
				"ACTIVITY_RECOGNITION"
			],
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.vitalistrack.app",
			"softwareKeyboardLayoutMode": "resize",
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO"
			]
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"@maplibre/maplibre-react-native",
			"expo-router",
			[
				"expo-secure-store",
				{
					"faceIDPermission": "Permita que o VitalisTrack use sua biometria para entrar na sua conta."
				}
			],
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "Permita que o VitalisTrack use sua localização durante atividades ao ar livre."
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Permita que o VitalisTrack selecione uma foto para seu perfil."
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Permita que o VitalisTrack leia o código de barras do alimento.",
					"recordAudioAndroid": false
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
