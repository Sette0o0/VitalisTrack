generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
 documents MedicalDocument[]
 wellbeing WellbeingRecord[]
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  profile      Profile[]
  goals        Goals[]
  sessions     RefreshSession[]
  water        WaterEntry[]
  meals        Meal[]
  activities   Activity[]
  weights      WeightEntry[]
  dailySteps   DailySteps[]
  mutations    ProcessedMutation[]
}

model Profile {
 documents MedicalDocument[]
 wellbeing WellbeingRecord[]
 invites FriendInvite[]
 friendshipsA Friendship[] @relation("FriendA")
 friendshipsB Friendship[] @relation("FriendB")
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  isPrimary  Boolean  @default(false)
  unitSystem String   @default("metric")
  goals Goals?
  nutrition NutritionProfile?
  recipes Recipe[]
  water WaterEntry[]
  meals Meal[]
  activities Activity[]
  weights WeightEntry[]
  dailySteps DailySteps[]
  name       String
  birthDate  DateTime? @db.Date
  weightKg   Float?
  heightCm   Float?
  gender     String?
  avatarPath String?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goals {
  profileId    String   @id @db.Uuid
  userId       String   @db.Uuid
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  waterMl      Int      @default(2500)
  calories     Int      @default(2000)
  mealCalories Int      @default(700)
  steps        Int      @default(10000)
  weightKg     Float    @default(70)
  dailyDeficit Int      @default(400)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model WaterEntry {
  id        String    @id @db.Uuid
  profileId String @db.Uuid
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  amountMl  Int
  date      DateTime  @db.Date
  time      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, profileId, date])
  @@index([userId, profileId, updatedAt])
}

model Meal {
  id        String    @id @db.Uuid
  profileId String @db.Uuid
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  nutrition Json?
  name      String
  date      DateTime  @db.Date
  time      String
  quantity  Float
  unit      String
  calories  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, profileId, date])
  @@index([userId, profileId, updatedAt])
}

model Activity {
 visibility String @default("private")
 heartRate Json?
  id              String               @id @db.Uuid
  profileId String @db.Uuid
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId          String               @db.Uuid
  type            String
  date            DateTime             @db.Date
  durationSeconds Int
  distanceMeters  Float
  calories        Int
  paceSecondsPerKm Float?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  route            ActivityRoutePoint[]

  @@index([userId, profileId, date])
  @@index([userId, profileId, updatedAt])
}

model ActivityRoutePoint {
  id         BigInt   @id @default(autoincrement())
  activityId String   @db.Uuid
  sequence   Int
  latitude   Float
  longitude  Float
  altitude   Float?
  accuracy   Float?
  timestamp  DateTime
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, sequence])
}

model WeightEntry {
  id        String    @id @db.Uuid
  profileId String @db.Uuid
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  date      DateTime  @db.Date
  weightKg  Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, profileId, date])
  @@index([userId, profileId, updatedAt])
}

model DailySteps {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String @db.Uuid
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  date      DateTime @db.Date
  steps     Int
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([userId, profileId, updatedAt])
}

model ProcessedMutation {
  profileId String? @db.Uuid
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  mutationId String   @db.Uuid
  result     Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mutationId])
  @@index([userId, createdAt])
}

model NutritionProfile {
 profileId String @id @db.Uuid
 objective String
 restrictions String[]
 preferences String[]
 updatedAt DateTime @updatedAt
 profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
model Recipe {
 id String @id @db.Uuid
 profileId String @db.Uuid
 name String
 ingredients String
 instructions String
 nutrition Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 deletedAt DateTime?
 profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
 @@index([profileId, updatedAt])
}
model FoodCache {
 key String @id
 value Json
 expiresAt DateTime
}

model WellbeingRecord {
 id String @id @db.Uuid
 userId String @db.Uuid
 profileId String @db.Uuid
 kind String
 data Json
 revision BigInt @unique @default(autoincrement())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 deletedAt DateTime?
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 profile Profile @relation(fields:[profileId],references:[id],onDelete:Cascade)
 @@index([profileId,kind,createdAt,id])
 @@index([profileId,revision])
}
model FriendInvite {
 code String @id
 profileId String @db.Uuid
 expiresAt DateTime
 used Boolean @default(false)
 profile Profile @relation(fields:[profileId],references:[id],onDelete:Cascade)
}
model Friendship {
 id String @id @default(uuid()) @db.Uuid
 aId String @db.Uuid
 bId String @db.Uuid
 requestedBy String @db.Uuid
 status String @default("pending")
 updatedAt DateTime @updatedAt
 a Profile @relation("FriendA",fields:[aId],references:[id],onDelete:Cascade)
 b Profile @relation("FriendB",fields:[bId],references:[id],onDelete:Cascade)
 @@unique([aId,bId])
}

model MedicalDocument {
 id String @id @db.Uuid
 userId String @db.Uuid
 profileId String @db.Uuid
 name String
 mimeType String
 size Int
 sha256 String
 storageName String
 revision BigInt @unique @default(autoincrement())
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 deletedAt DateTime?
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 profile Profile @relation(fields:[profileId],references:[id],onDelete:Cascade)
 @@index([userId,profileId,createdAt,id])
 @@index([profileId,revision])
}
