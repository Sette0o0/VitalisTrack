{
	"name": "@vitalis/server",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup ./src/index.ts --format esm --platform node --target node24 --out-dir dist --sourcemap --no-splitting",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src test --max-warnings=0",
		"test": "vitest run --coverage",
		"test:unit": "vitest run",
		"db:generate": "prisma generate --config prisma7.config.ts",
		"db:migrate": "prisma migrate dev --config prisma7.config.ts",
		"db:deploy": "prisma migrate deploy --config prisma7.config.ts",
		"db:seed": "tsx prisma/seed.ts",
		"load:sync": "tsx scripts/load-sync.ts"
	},
	"dependencies": {
		"@fastify/cors": "^11.0.0",
		"@fastify/jwt": "^10.0.0",
		"@fastify/multipart": "^9.0.0",
		"@fastify/static": "^8.0.0",
		"@fastify/swagger": "^9.0.0",
		"@fastify/swagger-ui": "^5.0.0",
		"@prisma/adapter-pg": "^7.0.0",
		"@prisma/client": "^7.0.0",
		"@vitalis/contracts": "workspace:*",
		"argon2": "^0.44.0",
		"dotenv": "^17.0.0",
		"fastify": "^5.0.0",
		"fastify-plugin": "^5.0.0",
		"fastify-type-provider-zod": "^6.0.0",
		"pg": "^8.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.0.0",
		"@vitest/coverage-v8": "^3.2.4",
		"eslint": "^9.0.0",
		"prisma": "^7.0.0",
		"tsx": "^4.0.0",
		"tsup": "^8.5.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.0.0",
		"vitest": "^3.2.4"
	}
}
